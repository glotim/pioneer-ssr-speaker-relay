(kicad_wks (version 20220228) (generator pl_editor)
  (setup (textsize 1.3 1.3) (linewidth 0.15) (textlinewidth 0.15)
    (left_margin 3) (right_margin 3) (top_margin 3) (bottom_margin 3))
  (rect (name "border") (start 0 0 ltcorner) (end 0 0) (linewidth 0.2))
  (line (name "strip top") (start 0 5) (end 0 5 lbcorner))
  (line (name "div sheet") (start 13 0) (end 13 5))
  (line (name "div date") (start 36 0) (end 36 5))
  (line (name "div rev") (start 50 0) (end 50 5))
  (tbtext "${TITLE}" (name "title") (pos 2 2.5 lbcorner) (font bold) (justify left) (maxlen 80))
  (tbtext "Rev ${REVISION}" (name "rev") (pos 43 2.5) (justify center))
  (tbtext "${ISSUE_DATE}" (name "date") (pos 24.5 2.5) (justify center))
  (tbtext "Sheet ${#}/${##}" (name "sheet") (pos 6.5 2.5) (justify center))
)
